{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://checkgram.app/schemas/suggestion.json",
  "title": "SuggestionPayload",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "id",
    "document_id",
    "document_version",
    "suggestion_type",
    "status",
    "start",
    "end",
    "original_text",
    "replacement_text",
    "explanation",
    "confidence",
    "severity",
    "source",
    "rule_id",
    "category",
    "created_at"
  ],
  "properties": {
    "id": { "type": "string", "minLength": 1 },
    "document_id": { "type": "string", "minLength": 1 },
    "document_version": { "type": "integer", "minimum": 1 },
    "suggestion_type": {
      "enum": ["grammar", "spelling", "punctuation", "style", "clarity", "tone", "rewrite", "conciseness", "custom"]
    },
    "status": { "enum": ["active", "accepted", "dismissed", "ignored", "stale"] },
    "start": { "type": "integer", "minimum": 0 },
    "end": { "type": "integer", "exclusiveMinimum": 0 },
    "original_text": { "type": "string", "minLength": 1 },
    "replacement_text": { "type": ["string", "null"] },
    "explanation": { "type": "string", "minLength": 1 },
    "confidence": { "type": ["number", "null"], "minimum": 0, "maximum": 1 },
    "severity": { "type": "integer", "minimum": 1, "maximum": 5 },
    "source": { "enum": ["languagetool", "openai", "system"] },
    "rule_id": { "type": ["string", "null"] },
    "category": { "enum": ["correctness", "clarity", "tone", "style", "rewriting"] },
    "alternatives": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text"],
        "properties": {
          "text": { "type": "string", "minLength": 1 },
          "label": { "type": "string" },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "metadata": { "type": "object" },
    "created_at": { "type": "string", "format": "date-time" }
  }
}
